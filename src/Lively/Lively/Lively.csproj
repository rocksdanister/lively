<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.18362.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject></StartupObject>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyVersion>2.2.1.5</AssemblyVersion>
    <Platforms>AnyCPU;x64;arm64</Platforms>
    <!-- .NET 9 Win10 issue, ref: https://github.com/rocksdanister/lively/issues/3028 -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <PropertyGroup>
    <TaskbarUtilityRequired Condition="'$(TaskbarUtilityRequired)' == '' And '$(IsMsixRelease)' == 'true'">true</TaskbarUtilityRequired>
    <TaskbarUtilityRequired Condition="'$(TaskbarUtilityRequired)' == ''">false</TaskbarUtilityRequired>
    <TaskbarUtilityBridgeArchitecture Condition="'$(TaskbarUtilityBridgeArchitecture)' == '' And '$(Platform)' == 'arm64'">arm64</TaskbarUtilityBridgeArchitecture>
    <TaskbarUtilityBridgeArchitecture Condition="'$(TaskbarUtilityBridgeArchitecture)' == ''">x64</TaskbarUtilityBridgeArchitecture>
    <TaskbarUtilityExe>$(TaskbarUtilityPublishDir)\Lively.Utility.Taskbar.exe</TaskbarUtilityExe>
    <TaskbarUtilityBridgeDll>$(TaskbarUtilityPublishDir)\TaskbarBridge\$(TaskbarUtilityBridgeArchitecture)\Lively.TaskbarBridge.dll</TaskbarUtilityBridgeDll>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DocumentationFile></DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DocumentationFile />
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Plugins\" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Plugins\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(TaskbarUtilityPublishDir)\**\*" Condition="'$(TaskbarUtilityPublishDir)' != '' And Exists('$(TaskbarUtilityPublishDir)')" Link="plugins\taskbar\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Bundle\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="ValidateTaskbarUtilityForMsixBuild" BeforeTargets="PrepareForBuild" Condition="'$(TaskbarUtilityRequired)' == 'true'">
    <Error Condition="'$(TaskbarUtilityPublishDir)' == ''" Text="TaskbarUtilityPublishDir must point to the Lively.Utility.Taskbar publish directory for Release/MSIX builds." />
    <Error Condition="'$(TaskbarUtilityPublishDir)' != '' And !Exists('$(TaskbarUtilityExe)')" Text="Lively.Utility.Taskbar.exe was not found in TaskbarUtilityPublishDir: $(TaskbarUtilityPublishDir)" />
    <Error Condition="'$(TaskbarUtilityPublishDir)' != '' And !Exists('$(TaskbarUtilityBridgeDll)')" Text="Lively.TaskbarBridge.dll was not found for $(TaskbarUtilityBridgeArchitecture): $(TaskbarUtilityBridgeDll)" />
  </Target>

  <Target Name="ValidateTaskbarUtilityForPublish" BeforeTargets="Publish" Condition="'$(TaskbarUtilityRequired)' == 'true' Or '$(TaskbarUtilityPublishDir)' != ''">
    <Error Condition="'$(TaskbarUtilityPublishDir)' == ''" Text="TaskbarUtilityPublishDir must point to the Lively.Utility.Taskbar publish directory for Release/MSIX builds." />
    <Error Condition="'$(TaskbarUtilityPublishDir)' != '' And !Exists('$(TaskbarUtilityExe)')" Text="Lively.Utility.Taskbar.exe was not found in TaskbarUtilityPublishDir: $(TaskbarUtilityPublishDir)" />
    <Error Condition="'$(TaskbarUtilityPublishDir)' != '' And !Exists('$(TaskbarUtilityBridgeDll)')" Text="Lively.TaskbarBridge.dll was not found for $(TaskbarUtilityBridgeArchitecture): $(TaskbarUtilityBridgeDll)" />
  </Target>

  <ItemGroup>
    <None Remove="Assets\Plugins\Mpv\LivelyProperties.json" />
    <None Remove="Assets\Plugins\Mpv\LivelyProperties.loc.json" />
    <None Remove="Nlog.config" />
    <None Remove="Resources\appicon_96.png" />
    <None Remove="Resources\splash.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Plugins\Mpv\LivelyProperties.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Plugins\Mpv\LivelyProperties.loc.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GrpcDotNetNamedPipes" Version="3.1.0" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.9.1" />
    <PackageReference Include="NLog" Version="6.0.6" />
    <PackageReference Include="RawInput.Sharp" Version="0.1.3" />
    <PackageReference Include="Sentinel.NLogViewer" Version="2.0.1" />
    <PackageReference Include="WinEventHook" Version="0.3.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lively.Common.Services\Lively.Common.Services.csproj" />
    <ProjectReference Include="..\Lively.Grpc.Common\Lively.Grpc.Common.csproj" />
    <ProjectReference Include="..\Lively.Models\Lively.Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\appicon_96.png" />
    <Resource Include="Resources\splash.png" />
  </ItemGroup>


  <ItemGroup>
    <Compile Update="Properties\Icons.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Icons.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Icons.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Icons.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
